# Copy this file to .env.school.local. Vite loads it only for `npm run build:school`.
# The marker prevents a school build from silently falling back to the personal
# credentials in .env.local if one of the school values is missing.
VITE_DEPLOYMENT_TARGET=school
VITE_BASE_PATH=/smart-notebook-converter-school/
VITE_GOOGLE_CLIENT_ID=your-school-client-id.apps.googleusercontent.com
VITE_GOOGLE_API_KEY=your-school-restricted-google-picker-api-key
VITE_GOOGLE_APP_ID=your-school-google-cloud-project-number
# Optional until Google Search Console gives the school account its own token.
VITE_GOOGLE_SITE_VERIFICATION=
